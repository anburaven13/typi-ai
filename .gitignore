# ════════════════════════════════════════════════════════════════════
# TypiAI — .gitignore
# ════════════════════════════════════════════════════════════════════

# ── Gradle build outputs ─────────────────────────────────────────────
.gradle/
build/
*/build/
**/build/

# ── Android build artefacts ──────────────────────────────────────────
*.apk
*.aab
*.ap_
*.dex
*.class

# ProGuard mapping — keep if you publish to Play Store (optional)
# Uncomment to track obfuscated crash stacks:
# !app/build/outputs/mapping/release/mapping.txt

# ── Local configuration ──────────────────────────────────────────────
local.properties
keystore.properties
*.jks
*.keystore

# ── IntelliJ / Android Studio ────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# ── Kotlin/JVM ───────────────────────────────────────────────────────
*.kotlin_module

# ── OS junk ──────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100
.Trashes

# ── Lint ─────────────────────────────────────────────────────────────
lint/
lint.xml
build/reports/

# ── Test results ─────────────────────────────────────────────────────
test-results/
jacoco/

# ── Secrets (never commit!) ───────────────────────────────────────────
google-services.json
*.env
secrets.properties

# ── NDK ──────────────────────────────────────────────────────────────
obj/

# ── Generated sources ────────────────────────────────────────────────
generated/
